# DuCO-Agent Environment Variables
# Copy this file to .env and fill in your values

# Google Gemini API Key (Required)
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Mock Insurance API Base URLs (local FastAPI servers)
INSURER1_API_URL=http://localhost:8001
INSURER2_API_URL=http://localhost:8002

# Output Directories
OUTPUT_DIR=./outputs
MOCK_INPUTS_DIR=./mock_inputs

# Logging
LOG_LEVEL=INFO
